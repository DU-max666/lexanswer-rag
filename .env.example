# 法衡 · 环境变量样例（全部为占位符，复制为 .env 后按注释填写）
# 留空 = 对应能力自动降级本地 mock，核心链路仍可跑通。

# ==== 检索层 ====
# BGE-M3 模型目录（本地路径或 HF 名称；留空使用哈希模拟嵌入）
LEXANSWER_BGE_M3_PATH=
# BGE-Reranker 精排模型路径（留空使用词面降级打分）
LEXANSWER_RERANKER_PATH=
# 微调后 BERT 意图闸门检查点路径（留空使用规则闸门）
LEXANSWER_INTENT_BERT_PATH=
# Milvus 服务地址（留空使用内存向量库）
LEXANSWER_MILVUS_URI=
LEXANSWER_MILVUS_TOKEN=
# FAQ 短路库路径（BM25 jsonl，仓库自带示例）
LEXANSWER_FAQ_PATH=corpus/faq.jsonl

# ==== 生成层 ====
# 本地 vLLM OpenAI 兼容端点（如 http://127.0.0.1:8000/v1）
LEXANSWER_MODEL_BASE_URL=
LEXANSWER_MODEL_API_KEY=<local-vllm-no-auth>
LEXANSWER_MODEL_NAME=lexanswer-7b
# 云端通道（默认留空！仅公开问题脱敏后允许使用，见 docs/security.md）
LEXANSWER_CLOUD_BASE_URL=
LEXANSWER_CLOUD_API_KEY=<your-cloud-api-key>
# mock 网关回答风格：base | finetuned（无模型端点时生效）
LEXANSWER_MOCK_STYLE=finetuned

# ==== 服务层 ====
# 令牌→角色映射（partner/associate/assistant/client）
LEXANSWER_TOKEN_ROLES=<demo-token-partner>:partner,<demo-token-client>:client
# 审计日志路径
LEXANSWER_AUDIT_LOG=logs/audit.jsonl
PORT=8080

# ==== 业务存储（docker-compose 用）====
MYSQL_ROOT_PASSWORD=<change-me>
MYSQL_PASSWORD=<change-me>
MINIO_ACCESS_KEY=<change-me>
MINIO_SECRET_KEY=<change-me>
